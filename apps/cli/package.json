{
  "name": "vde-open",
  "version": "0.1.9",
  "description": "A local document viewer shared by agents and people: open Markdown and HTML documents, search and read them from the CLI, and ask the person questions.",
  "keywords": [
    "agent",
    "cli",
    "documents",
    "html",
    "markdown",
    "search",
    "viewer"
  ],
  "homepage": "https://github.com/yuki-yano/vde-open#readme",
  "bugs": {
    "url": "https://github.com/yuki-yano/vde-open/issues"
  },
  "license": "MIT",
  "author": "Yuki Yano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuki-yano/vde-open.git",
    "directory": "apps/cli"
  },
  "bin": {
    "vde-open": "dist/cli.js",
    "vo": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "docs/agent-usage.md",
    "skills"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsdown"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.3",
    "@vde-open/document": "workspace:*",
    "@vde-open/shared": "workspace:*",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "hono": "4.13.12",
    "minisearch": "7.2.0",
    "tinyglobby": "0.2.17",
    "tsdown": "0.23.0",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
