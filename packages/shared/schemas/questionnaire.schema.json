{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vde-open:questionnaire:1",
  "title": "vde-open questionnaire format version 1",
  "description": "Trusted local meta-schema. Cross-field equality, numeric bounds, byte budgets and defaults are additionally enforced by application validation.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "instructions": {
      "type": "string",
      "maxLength": 4000
    },
    "fieldOrder": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      }
    },
    "answerSchema": {
      "type": "object",
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
            "not": {
              "enum": ["__proto__", "constructor", "prototype"]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          }
        },
        "additionalProperties": {
          "const": false
        }
      },
      "required": ["type", "properties", "required", "additionalProperties"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "title", "fieldOrder", "answerSchema"],
  "additionalProperties": false,
  "$defs": {
    "field": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "string"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "minLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4000
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4000
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 160
              }
            }
          },
          "required": ["type", "title"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "boolean"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": ["type", "title"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["number", "integer"]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          },
          "required": ["type", "title"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "array"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "minItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            },
            "maxItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            },
            "uniqueItems": {
              "const": true
            },
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "string"
                },
                "enum": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "maxLength": 160
                  }
                }
              },
              "required": ["type", "enum"],
              "additionalProperties": false
            }
          },
          "required": ["type", "title", "items", "uniqueItems", "maxItems"],
          "additionalProperties": false
        }
      ]
    }
  }
}
